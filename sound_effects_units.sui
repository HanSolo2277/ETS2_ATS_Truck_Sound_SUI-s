# FH6_2024_05_active | D16 780 PS (Zeemods D13 adaptiert auf D16)

sound_reverb_data : .effect.reverb.window.closed
{
    decay_time: 320.0
    early_delay: 5.0
    late_delay: 10.0
    hf_reference: 5000.0
    hf_decay_ratio: 25.0
    diffusion: 35.0
    density: 35.0
    low_shelf_frequency: 250.0
    low_shelf_gain: 0.10
    high_cut: 5000.0
    early_late_mix: 50.0
    wet_level: -32.0
    dry_level: -13.0
}

sound_reverb_data : .effect.reverb.window.opened
{
    decay_time: 500.0
    early_delay: 10.0
    late_delay: 20.0
    hf_reference: 5000.0
    hf_decay_ratio: 30.0
    diffusion: 40.0
    density: 40.0
    low_shelf_frequency: 250.0
    low_shelf_gain: 0.12
    high_cut: 6000.0
    early_late_mix: 60.0
    wet_level: -32.0
    dry_level: -13.0
}

sound_three_eq_data : .effect.equalizer.cabin.inside
{
    low_gain: 8.0
    mid_gain: -1.0
    high_gain: -2.5
    low_crossover: 300.0
    high_crossover: 2000.0
    crossover_slope: 2
}

sound_three_eq_data : .effect.equalizer.cabin.outside
{
    low_gain: 4.0
    mid_gain: 4.0
    high_gain: 4.0
    low_crossover: 200.0
    high_crossover: 22000.0
    crossover_slope: 2
}

sound_three_eq_data : .effect.add.window_eq.closed
{
    low_gain: -40.0
    mid_gain: -40.0
    high_gain: -40.0
    low_crossover: 300.0
    high_crossover: 4000.0
    crossover_slope: 2
}

sound_three_eq_data : .effect.add.window_eq.opened
{
    low_gain: -13.0
